{
  "name": "forgetmenot-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "FMN_SKIP_SCREENSHOTS=1 playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "e2e:visual": "docker compose -f e2e/compose.yml run --rm playwright",
    "e2e:update": "FMN_PLAYWRIGHT_ARGS=--update-snapshots docker compose -f e2e/compose.yml run --rm playwright"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@milkdown/crepe": "^7.23.0",
    "@observablehq/plot": "^0.6.18",
    "@shoelace-style/shoelace": "^2.20.1",
    "@tabler/icons": "^3.50.0",
    "@tanstack/lit-table": "^9.3.1",
    "diff": "^9.0.0",
    "lit": "^3.3.3",
    "modern-normalize": "^3.0.1",
    "universal-router": "^10.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
